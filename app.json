{
  "expo": {
    "name": "Refit",
    "slug": "refit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.option.refit"
    },
    "android": {
      "package": "com.option.refit",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "refit",
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.456269811591-iq2v2d75dmlbf3pc6hv2b88nrc9o3ne7"
        }
      ],
      "expo-build-properties",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "수업 출석을 위해 NFC 태그를 읽습니다."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b1970af9-98cc-4c27-9667-23c26794efaf"
      }
    }
  }
}
